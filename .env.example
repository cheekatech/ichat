# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional but strongly recommended for calls across different networks / mobile data.
# Any TURN provider works (Metered, Twilio, Cloudflare, coturn...).
# VITE_TURN_URL=turn:your.turn.host:443?transport=tcp,turns:your.turn.host:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
